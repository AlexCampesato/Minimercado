@model IEnumerable<Eventos.Data.Modelos.Producto>

@{
    ViewData["Title"] = "Listado de Productos";
}

<div class="container mt-4">
    <h2>Listado de Productos - Minimercado Inteligente</h2>

    <p class="mt-3">
        <a asp-action="Create" class="btn btn-success">➕ Agregar Nuevo Producto</a>
    </p>

    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Precio ($)</th>
                <th>Peso (Gramos)</th>
                <th>Categoría</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.Nombre</td>
                    <td>$@item.Precio</td>
                    <td>@item.PesoGramos g</td>
                    <td>@(item.Categoria?.Nombre ?? "Sin categoría")</td>
                </tr>
            }
        </tbody>
    </table>
</div>