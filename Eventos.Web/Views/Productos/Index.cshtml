@model IEnumerable<Eventos.Data.Modelos.Producto>

@{
    ViewData["Title"] = "Listado de Productos";
}

<h2>Listado de Productos</h2>

<!-- 🟢 SOLO EL ADMINISTRADOR VE EL BOTÓN DE CREAR NUEVO -->
@if (User.IsInRole("Administrador"))
{
    <p>
        <a asp-action="Create" class="btn btn-success">Crear Nuevo Producto</a>
    </p>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Precio)</th>
            <th>@Html.DisplayNameFor(model => model.PesoGramos)</th>
            <th>Categoría</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>$@Html.DisplayFor(modelItem => item.Precio)</td>
                <td>@Html.DisplayFor(modelItem => item.PesoGramos) g</td>
                <td>@Html.DisplayFor(modelItem => item.Categoria.Nombre)</td>
                <td>
                    <!-- 🟢 EL ADMINISTRADOR PUEDE EDITAR -->
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Editar</a>
                    }

                    <!-- 🟢 EL CLIENTE PUEDE AGREGAR AL CARRITO (Próximo paso) -->
                    @if (User.IsInRole("Cliente"))
                    {
                        <form asp-controller="Carrito" asp-action="Agregar" method="post" class="d-inline">
                            <input type="hidden" name="productoId" value="@item.Id" />
                            <button type="submit" class="btn btn-warning btn-sm">Agregar al Carrito 🛒</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>